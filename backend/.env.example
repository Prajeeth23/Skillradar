APP_NAME="SkillRadar"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database Configuration
# In Docker Compose, variables are interpolated from POSTGRES_USER and POSTGRES_PASSWORD:
# DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="choose_a_strong_password_here"
POSTGRES_DB="skillradar"

# For local development SQLite:
DATABASE_URL="sqlite:///./skillradar.db"

# Security & JWT
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(32))"
# In development, if omitted, a cryptographically random 256-bit secret is generated automatically.
JWT_SECRET=""
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# API Documentation (true/false, defaults to False in production)
DOCS_ENABLED=True

# Groq AI Service
# Set your Groq API Key here. If empty, the engine uses a high-fidelity deterministic fallback.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_TIMEOUT_SECONDS=20

# CORS Configuration (comma-separated list or JSON array of allowed origins)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","http://127.0.0.1:5173"]

