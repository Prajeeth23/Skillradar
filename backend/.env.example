APP_NAME="SkillRadar"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database Configuration
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/skillradar
# For instant zero-dependency SQLite fallback: sqlite:///./skillradar.db
DATABASE_URL="sqlite:///./skillradar.db"

# Security & JWT
JWT_SECRET="skillradar-super-secret-jwt-key-hackathon-2026-beyond-titles"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Groq AI Service
# Set your Groq API Key here. If empty, the engine uses a high-fidelity deterministic fallback.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_TIMEOUT_SECONDS=20

# CORS Configuration
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","http://127.0.0.1:5173"]
